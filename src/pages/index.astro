---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  lede,
  links,
  profile,
  publications
} from "../data/site";
---

<BaseLayout>
  <section class="hero">
    <div class="page hero-grid">
      <div class="portrait-frame">
        <img
          class="portrait"
          src="/profile-beach.jpg"
          alt={profile.name}
          width="583"
          height="583"
        />
      </div>
      <div class="hero-copy">
        <h1>{profile.name}</h1>
        <p class="lede">{lede}</p>
        <p class="affil">
          I am an M.S. student in Intelligent Technology Systems at the{" "}
          <a href={profile.schoolUrl}>Miin Wu School of Computing</a>,{" "}
          <a href={profile.universityUrl}>National Cheng Kung University</a>. I am advised by{" "}
          <a href={profile.advisorUrl}>Prof. Shao-Man Lee</a> in the{" "}
          <a href={profile.labUrl}>SocioLegal Lab</a>.
        </p>
        <ul class="cta">
          <li><a href={profile.cvPath}>Download CV</a></li>
          {links
            .filter((link) => link.label !== "CV")
            .map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="block" id="publications">
    <div class="page publication-layout">
      <h2>Publications</h2>
      <div class="pubs">
        {publications.map((pub) => (
          <article class="pub">
            <div class="pub-year">{pub.year}</div>
            <div>
              <div class="pub-title">{pub.title}</div>
              <p class="pub-meta">{pub.authors}</p>
              <p class="pub-meta">
                {pub.venue}{pub.note ? ` · ${pub.note}` : ""}
              </p>
              {pub.links.length > 0 && (
                <p class="pub-links">
                  {pub.links.map((link) => (
                    <a href={link.href}>{link.label} ↗</a>
                  ))}
                </p>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="cv-continuation" data-scroll-reveal>
    <a href="/cv/">
      <span>Continue to Curriculum vitae</span>
      <span class="cv-continuation-arrow" aria-hidden="true">&rarr;</span>
    </a>
  </div>

  <script>
    const continuation = document.querySelector<HTMLElement>("[data-scroll-reveal]");

    if (continuation) {
      const link = continuation.querySelector<HTMLAnchorElement>("a");
      const destination = link?.href ?? "/cv/";
      const threshold = 220;
      let pullDistance = 0;
      let lastInput = 0;
      let lastTouchY: number | undefined;
      let navigating = false;

      const isAtPageEnd = () =>
        window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;

      const renderProgress = () => {
        const progress = Math.min(pullDistance / threshold, 1);
        continuation.style.setProperty("--pull-opacity", String(0.48 + progress * 0.52));
        continuation.style.setProperty("--pull-offset", `${(1 - progress) * 0.5}rem`);
      };

      const resetProgress = () => {
        pullDistance = 0;
        renderProgress();
      };

      const continueToCV = (distance: number) => {
        if (navigating) return;
        if (!isAtPageEnd() || distance <= 0) {
          if (distance < 0) resetProgress();
          return;
        }

        const now = performance.now();
        if (now - lastInput > 700) pullDistance = 0;
        lastInput = now;
        pullDistance += Math.min(distance, 80);
        renderProgress();

        if (pullDistance < threshold) return;
        navigating = true;
        continuation.classList.add("is-leaving");
        window.setTimeout(() => window.location.assign(destination), 140);
      };

      window.addEventListener("wheel", (event) => continueToCV(event.deltaY), { passive: true });
      window.addEventListener(
        "touchstart",
        (event) => {
          lastTouchY = event.touches[0]?.clientY;
        },
        { passive: true }
      );
      window.addEventListener(
        "touchmove",
        (event) => {
          const currentY = event.touches[0]?.clientY;
          if (currentY === undefined || lastTouchY === undefined) return;
          continueToCV(lastTouchY - currentY);
          lastTouchY = currentY;
        },
        { passive: true }
      );
      window.addEventListener("scroll", () => {
        if (!isAtPageEnd()) resetProgress();
      }, { passive: true });

      renderProgress();
    }
  </script>
</BaseLayout>
